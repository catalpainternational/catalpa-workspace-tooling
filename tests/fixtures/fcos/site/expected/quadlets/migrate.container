# Generated by `dk staging render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=site migrate
Requires=db.service
After=db.service
PartOf=django.service
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=migrate
Image=ghcr.io/example/site-django:v1.2.3
Network=site_default.network
UIDMap=0:20000:5000
GIDMap=0:20000:5000
EnvironmentFile=/etc/site/migrate.env
Secret=altcha_hmac_secret,type=env,target=ALTCHA_HMAC_SECRET
Volume=/var/mnt/data/django_media:/media:z
Exec=python manage.py migrate --noinput

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1800
