# Generated by `dk staging render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=site collectstatic
PartOf=django.service

[Container]
ContainerName=collectstatic
Image=ghcr.io/example/site-django:v1.2.3
Network=site_default.network
UIDMap=0:20000:5000
GIDMap=0:20000:5000
EnvironmentFile=/etc/site/collectstatic.env
Secret=altcha_hmac_secret,type=env,target=ALTCHA_HMAC_SECRET
Volume=django_static.volume:/app/static:z
Exec=python manage.py collectstatic --noinput

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1800
