# Generated by `dk staging fcos render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=site db
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=db
Image=ghcr.io/example/site-postgres:v1.2.3
Network=site_default.network
UIDMap=0:10000:5000
GIDMap=0:10000:5000
EnvironmentFile=/etc/site/db.env
Secret=postgres_password,type=env,target=POSTGRES_PASSWORD
Volume=/var/mnt/data/pgdata:/var/lib/postgresql:Z
HealthCmd=pg_isready -U postgres
HealthInterval=3s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=10
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
