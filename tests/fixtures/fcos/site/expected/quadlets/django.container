# Generated by `dk staging fcos render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=site django
Requires=collectstatic.service migrate.service
After=collectstatic.service migrate.service
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=django
Image=ghcr.io/example/site-django:v1.2.3
Network=site_default.network
UIDMap=0:20000:5000
GIDMap=0:20000:5000
EnvironmentFile=/etc/site/django.env
Secret=altcha_hmac_secret,type=env,target=ALTCHA_HMAC_SECRET
Volume=/var/mnt/data/django_media:/media:z
PodmanArgs=--memory=1073741824

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
