# Generated by `dk staging fcos render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=site caddy
Requires=caddy.socket
Wants=django.service
After=caddy.socket django.service
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=caddy
Image=ghcr.io/example/site-caddy:v1.2.3
Network=site_default.network
UIDMap=0:30000:5000
GIDMap=0:30000:5000
EnvironmentFile=/etc/site/caddy.env
Volume=/var/mnt/data/caddy_data:/data:Z
Volume=caddy_config.volume:/config:z
Volume=django_static.volume:/srv/static:ro,z
Volume=/var/mnt/data/django_media:/srv/media:ro,z
Volume=/var/home/deploy/.config/site/caddy.json:/etc/caddy/caddy.json:ro,Z
Exec=caddy run --config /etc/caddy/caddy.json

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
