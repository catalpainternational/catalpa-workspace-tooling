{
  "env": "staging",
  "compose_file": "compose.yml",
  "user": "deploy",
  "uid": 1001,
  "subuid": {
    "start": 589824,
    "count": 65536
  },
  "auto_update": false,
  "network": "site_default",
  "id_ranges": {
    "caddy": {
      "start": 30000,
      "size": 5000,
      "host_root_uid": 619823,
      "services": [
        "caddy"
      ]
    },
    "db": {
      "start": 10000,
      "size": 5000,
      "host_root_uid": 599823,
      "services": [
        "db"
      ]
    },
    "django": {
      "start": 20000,
      "size": 5000,
      "host_root_uid": 609823,
      "services": [
        "collectstatic",
        "django",
        "migrate"
      ]
    }
  },
  "bind_volumes": {
    "caddy_data": {
      "path": "/var/mnt/data/caddy_data",
      "services": [
        "caddy"
      ],
      "id_range": "caddy",
      "owner_uid": 619823,
      "mode": "0700"
    },
    "django_media": {
      "path": "/var/mnt/data/django_media",
      "services": [
        "caddy",
        "django",
        "migrate"
      ],
      "id_range": "django",
      "owner_uid": 609823,
      "mode": "0755"
    },
    "pgdata": {
      "path": "/var/mnt/data/pgdata",
      "services": [
        "db"
      ],
      "id_range": "db",
      "owner_uid": 600822,
      "mode": "0700"
    }
  },
  "podman_volumes": {
    "caddy_config": "site_caddy_config",
    "django_static": "site_django_static"
  },
  "images": {
    "caddy": "ghcr.io/example/site-caddy:v1.2.3",
    "collectstatic": "ghcr.io/example/site-django:v1.2.3",
    "db": "ghcr.io/example/site-postgres:v1.2.3",
    "django": "ghcr.io/example/site-django:v1.2.3",
    "migrate": "ghcr.io/example/site-django:v1.2.3"
  },
  "secrets": {
    "altcha_hmac_secret": "ALTCHA_HMAC_SECRET",
    "postgres_password": "POSTGRES_PASSWORD"
  },
  "install": [
    {
      "file": "caddy/caddy.json",
