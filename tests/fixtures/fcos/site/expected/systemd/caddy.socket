# Generated by `dk staging render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=site edge sockets (80, 443, 443/udp)

[Socket]
# Passed to the container in this order: fd 3, fd 4, fd 5 (see caddy.json).
BindIPv6Only=both
ListenStream=[::]:80
ListenStream=[::]:443
ListenDatagram=[::]:443

[Install]
WantedBy=sockets.target
