# Generated by `dk staging fcos render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
# pgBackRest backup of type %i (full, incr or diff) inside db. By hand:
#   systemctl --user start bero_shape-pgbackrest-backup@full.service
[Unit]
Description=pgBackRest %i backup
Requires=db.service
After=db.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec -u postgres db pgbackrest --log-level-console=info backup --type=%i
# Refresh the status Zabbix reads. --no-block: don't wait for it.
ExecStartPost=/usr/bin/systemctl --user start --no-block bero_shape-backup-status.service
