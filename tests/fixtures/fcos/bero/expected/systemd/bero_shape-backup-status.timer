# Generated by `dk staging fcos render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
# Hourly, so Zabbix sees WAL archiving between backups, and the files' age shows
# whether this job runs.
[Unit]
Description=Hourly backup status for Zabbix

[Timer]
OnCalendar=hourly
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
