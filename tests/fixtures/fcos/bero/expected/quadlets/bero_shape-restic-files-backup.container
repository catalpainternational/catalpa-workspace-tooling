# Generated by `dk staging fcos render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=restic backup of django_media
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=bero_shape-restic-files-backup
Image=docker.io/restic/restic:0.17.3
UIDMap=0:10000:5000
GIDMap=0:10000:5000
Secret=restic_write_password,type=env,target=RESTIC_PASSWORD
Secret=restic_write_repository,type=env,target=RESTIC_REPOSITORY
Secret=restic_write_s3_access_key_id,type=env,target=AWS_ACCESS_KEY_ID
Secret=restic_write_s3_default_region,type=env,target=AWS_DEFAULT_REGION
Secret=restic_write_s3_secret_access_key,type=env,target=AWS_SECRET_ACCESS_KEY
Volume=/var/mnt/data/django_media:/backup/django_media:ro,z
# restic's cache, so each run doesn't download the repository index again.
Volume=bero_shape_restic_cache:/root/.cache/restic
# A fixed --host: the container's own hostname changes every run, so restic would
# find no parent snapshot and `forget` couldn't group snapshots.
Exec=backup --host bero-shape-staging /backup/django_media
# Output once, as the unit's (journalctl -u): a one-shot needs no `podman logs`,
# and with Podman's journald driver every line was logged twice.
LogDriver=passthrough

[Service]
Type=oneshot
TimeoutStartSec=3600
# Refresh the status Zabbix reads. --no-block: don't wait for it.
ExecStartPost=/usr/bin/systemctl --user start --no-block bero_shape-backup-status.service
