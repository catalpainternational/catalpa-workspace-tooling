# Generated by `dk staging fcos render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=bero_shape db
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=db
Image=ghcr.io/example/bero_shape-db:v7.4.1
AutoUpdate=registry
Network=bero_shape_default.network
UIDMap=0:15000:5000
GIDMap=0:15000:5000
EnvironmentFile=/etc/bero_shape/db.env
Secret=postgres_password,type=env,target=POSTGRES_PASSWORD
Volume=/var/mnt/data/postgres_data:/var/lib/postgresql:Z
ShmSize=268435456
HealthCmd=["pg_isready", "-U", "postgres"]
HealthInterval=5s
HealthRetries=5
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
