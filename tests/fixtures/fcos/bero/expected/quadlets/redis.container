# Generated by `dk staging render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=bero_shape redis

[Container]
ContainerName=redis
Image=docker.io/library/redis:8.0-alpine
AutoUpdate=registry
Network=bero_shape_default.network
UIDMap=0:25000:5000
GIDMap=0:25000:5000
EnvironmentFile=/etc/bero_shape/redis.env
Volume=redis_data.volume:/data:z

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
