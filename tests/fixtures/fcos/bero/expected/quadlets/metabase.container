# Generated by `dk staging fcos render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=bero_shape metabase
Requires=db.service
After=db.service

[Container]
ContainerName=metabase
Image=docker.io/metabase/metabase:v0.62.x
AutoUpdate=registry
Network=bero_shape_default.network
UIDMap=0:20000:5000
GIDMap=0:20000:5000
EnvironmentFile=/etc/bero_shape/metabase.env
Secret=metabase_db_password,type=env,target=MB_DB_PASS
PodmanArgs=--memory=2147483648

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
