# Generated by `dk staging render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=bero_shape django
Requires=collectstatic.service migrate.service
Wants=redis.service
After=collectstatic.service migrate.service redis.service
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=django
Image=ghcr.io/example/bero_shape-django:v7.4.1
AutoUpdate=registry
Network=bero_shape_default.network
UIDMap=0:10000:5000
GIDMap=0:10000:5000
EnvironmentFile=/etc/bero_shape/django.env
Secret=django_secret_key,type=env,target=DJANGO_SECRET_KEY
Volume=/var/mnt/data/django_media:/django_media:z
Volume=django_static.volume:/static:z
Exec=gunicorn app.wsgi --bind 0.0.0.0:8000

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
