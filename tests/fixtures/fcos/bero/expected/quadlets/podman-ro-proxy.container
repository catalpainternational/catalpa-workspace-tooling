# Generated by `dk staging render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
# Read-only Podman API for the Zabbix agent. It holds the account's full Podman socket, so
# it runs as the account (no UIDMap), with no network, a read-only root filesystem and no
# capabilities. Its config is root-owned, so the account can't widen what it allows.
[Unit]
Description=Read-only Podman API for monitoring
Requires=podman.socket
After=podman.socket

[Container]
ContainerName=podman-ro-proxy
Image=docker.io/library/haproxy:3.0-alpine
AutoUpdate=registry
Network=none
User=0
Volume=/etc/bero_shape/podman-ro-proxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
# The socket's directory, not the file, so a restarted podman.socket is still seen.
Volume=%t/podman:/run/podman
Volume=/run/bero_shape-podman-ro:/run/podman-ro
# SELinux doesn't let a container connect to Podman's own socket.
SecurityLabelDisable=true
DropCapability=all
NoNewPrivileges=true
ReadOnly=true

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
