# Generated by `dk staging fcos render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=bero_shape caddy
Requires=caddy.socket
Wants=django.service metabase.service
After=caddy.socket django.service metabase.service
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=caddy
Image=ghcr.io/example/bero_shape-caddy:v7.4.1
AutoUpdate=registry
Network=bero_shape_default.network
UIDMap=0:10000:5000
GIDMap=0:10000:5000
EnvironmentFile=/etc/bero_shape/caddy.env
Volume=/var/mnt/data/caddy_data:/data:Z
Volume=caddy_config.volume:/config:z
Volume=django_static.volume:/django_static:z
Volume=/var/mnt/data/django_media:/django_media:z
Volume=/var/home/deploy/.config/bero_shape/caddy.json:/etc/caddy/caddy.json:ro,Z
Exec=caddy run --config /etc/caddy/caddy.json

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
