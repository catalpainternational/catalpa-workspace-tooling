# Generated by `dk staging fcos render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
# A root-owned system quadlet, so the account can't stop its own monitoring. The agent
# is NOT root: the image's zabbix user (uid 1997), no capabilities, no way to gain any,
# no container socket.
[Unit]
Description=Zabbix Agent 2
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=zabbix-agent2
Image=docker.io/zabbix/zabbix-agent2:alpine-7.0-latest
AutoUpdate=registry
# Host network and PID namespace: network and process items see the host's.
Network=host
PodmanArgs=--pid=host
# Disk items (vfs.fs.*) statfs the host's filesystems under /host/root. Read-only, and
# rslave so the data volume shows up if it's mounted after the agent starts.
Volume=/:/host/root:ro,rslave
# The read-only Podman API (podman-ro-proxy), and the Docker plugin pointed at it.
Volume=/run/bero_shape-podman-ro:/run/podman-ro:ro
Volume=/etc/bero_shape/zabbix-docker.conf:/etc/zabbix/zabbix_agent2.d/plugins.d/docker.conf:ro
# Backup status files, and the UserParameters that read them.
Volume=/var/lib/bero_shape-monitor:/var/lib/bero_shape-monitor:ro
Volume=/etc/bero_shape/zabbix-userparams.conf:/etc/zabbix/zabbix_agent2.d/plugins.d/99-bero_shape-userparams.conf:ro
# SELinux would block even stat-ing most host paths; file permissions still apply.
SecurityLabelDisable=true
DropCapability=all
NoNewPrivileges=true
Environment=ZBX_ACTIVE_ALLOW=true
Environment=ZBX_HOSTNAME=bero-staging.example
Environment=ZBX_METADATA=docker app
Environment=ZBX_PASSIVE_ALLOW=false
Environment=ZBX_SERVER_HOST=zabbix.catalpa.build
Environment=ZBX_TLSCONNECT=psk
Secret=zbx_tlspsk,type=env,target=ZBX_TLSPSK
Secret=zbx_tlspskidentity,type=env,target=ZBX_TLSPSKIDENTITY

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
