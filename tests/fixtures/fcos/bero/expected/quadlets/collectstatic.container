# Generated by `dk staging fcos render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=bero_shape collectstatic
PartOf=django.service
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=collectstatic
Image=ghcr.io/example/bero_shape-django:v7.4.1
Network=bero_shape_default.network
UIDMap=0:10000:5000
GIDMap=0:10000:5000
EnvironmentFile=/etc/bero_shape/collectstatic.env
Secret=django_secret_key,type=env,target=DJANGO_SECRET_KEY
Volume=/var/mnt/data/django_media:/django_media:z
Volume=django_static.volume:/static:z
Exec=python manage.py collectstatic --noinput

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1800
