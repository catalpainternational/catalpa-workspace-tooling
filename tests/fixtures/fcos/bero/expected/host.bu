# Generated by `dk staging render` from compose.yaml. Do not edit: change the compose file or info.yaml and render again.
# Compile in this directory:
#   podman run --rm -v "$PWD":/work:Z -w /work quay.io/coreos/butane:release \
#     --strict --files-dir . host.bu > host.ign
variant: fcos
version: 1.6.0

passwd:
  users:
    # Admins: passwordless sudo (FCOS default), so root-equivalent. Keys: fcos.admin_keys,
    # installed below as ~/.ssh/authorized_keys.d/dk (so `dk <env> apply` can change them).
    - name: core
    # Runs the stack (rootless Podman) and is what dk connects as. Keys:
    # fcos.ssh_authorized_keys. No sudo, no extra groups. A fixed uid: the quadlets live in
    # /etc/containers/systemd/users/<uid>/.
    - name: deploy
      uid: 1001

storage:
  # The DO block storage volume, attached when the droplet is created. Formatted on
  # first boot only: an existing XFS filesystem with this label is kept.
  filesystems:
    - device: /dev/disk/by-id/scsi-0DO_Volume_bero-shape-staging-data
      format: xfs
      label: data
      wipe_filesystem: false
      path: /var/mnt/data
      with_mount_unit: true

  directories:
    # Bind volumes, owned by the host uid of the user that writes them (see manifest.json).
    - path: /var/mnt/data/caddy_data
      mode: 0700
      user:
        id: 599823
      group:
        id: 599823
    - path: /var/mnt/data/django_media
      mode: 0700
      user:
        id: 599823
      group:
        id: 599823
    - path: /var/mnt/data/postgres_data
      mode: 0700
      user:
        id: 605822
      group:
        id: 605822
    # Backup status for the Zabbix agent: written by deploy, read by group 1995.
    - path: /var/lib/bero_shape-monitor
      mode: 0750
      user:
        name: deploy
      group:
        id: 1995
    - path: /etc/bero_shape
      mode: 0755
    # Root-owned: deploy runs these quadlets but can't edit them.
    - path: /etc/containers/systemd/users/1001
      mode: 0755
    # core's and deploy's own directories. Ignition makes missing parents as root, so
    # each level is listed.
    - path: /var/home/core/.ssh
      mode: 0700
      user:
        name: core
      group:
        name: core
    - path: /var/home/core/.ssh/authorized_keys.d
      mode: 0700
      user:
        name: core
      group:
        name: core
    - path: /var/home/deploy/.config
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/bero_shape
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/sockets.target.wants
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.ssh
      mode: 0700
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.ssh/authorized_keys.d
      mode: 0700
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/containers
      mode: 0700
      user:
        name: deploy
      group:
        name: deploy

  links:
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Asia/Dili
      overwrite: true
    # Enable deploy's units (systemctl --user enable).
    - path: /var/home/deploy/.config/systemd/user/sockets.target.wants/caddy.socket
      target: ../caddy.socket
      user:
        name: deploy
      group:
        name: deploy
    # Docker-compatible API for dk.
    - path: /var/home/deploy/.config/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants/bero_shape-backup-status.timer
      target: ../bero_shape-backup-status.timer
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants/bero_shape-pgbackrest-backup-full.timer
      target: ../bero_shape-pgbackrest-backup-full.timer
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants/bero_shape-pgbackrest-backup-incr.timer
      target: ../bero_shape-pgbackrest-backup-incr.timer
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants/bero_shape-restic-files-backup.timer
      target: ../bero_shape-restic-files-backup.timer
      user:
        name: deploy
      group:
        name: deploy
    # fcos.auto_update: podman auto-update for units marked AutoUpdate=registry.
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants/podman-auto-update.timer
      target: /usr/lib/systemd/user/podman-auto-update.timer
      user:
        name: deploy
      group:
        name: deploy

  files:
    # Pinned subordinate IDs (what useradd picks anyway), so a change in that order can't
    # move the data directories' owners.
    - path: /etc/subuid
      mode: 0644
      overwrite: true
      contents:
        inline: |
          core:524288:65536
          deploy:589824:65536
    - path: /etc/subgid
      mode: 0644
      overwrite: true
      contents:
        inline: |
          core:524288:65536
          deploy:589824:65536
    # The DO image writes /etc/hostname before Ignition runs.
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: |
          bero-shape-staging
    # OS updates and their reboot only in this window (Asia/Dili).
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [updates.periodic]
          time_zone = "Asia/Dili"

          [[updates.periodic.window]]
          days = [ "Sun" ]
          start_time = "02:00"
          length_minutes = 60
    # deploy's systemd (and so the stack) starts at boot with nobody logged in.
    - path: /var/lib/systemd/linger/deploy
      mode: 0644
    # Lets deploy's systemd open 80 and 443 for the edge (caddy.socket).
    - path: /etc/sysctl.d/50-unprivileged-ports.conf
      mode: 0644
      contents:
        inline: |
          net.ipv4.ip_unprivileged_port_start = 80
    # Keep rootless Podman's registry login across reboots (default: /run/user/<uid>).
    - path: /etc/systemd/user.conf.d/10-registry-auth.conf
      mode: 0644
      contents:
        inline: |
          [Manager]
          DefaultEnvironment=REGISTRY_AUTH_FILE=/var/home/deploy/.config/containers/auth.json
    # Hardening: keys only, no root, few tries. Read before FCOS's own drop-ins (first
    # value wins).
    - path: /etc/ssh/sshd_config.d/10-hardening.conf
      mode: 0644
      contents:
        inline: |
          PasswordAuthentication no
          KbdInteractiveAuthentication no
          PermitRootLogin no
          MaxAuthTries 3
          X11Forwarding no
          AllowUsers core deploy
    # Hardening: no LLMNR or mDNS (resolved answers on 5355 by default).
    - path: /etc/systemd/resolved.conf.d/10-no-llmnr.conf
      mode: 0644
      contents:
        inline: |
          [Resolve]
          LLMNR=no
          MulticastDNS=no
    # Generated files (manifest.json's install map).
    - path: /etc/bero_shape/caddy.env
      mode: 0644
      contents:
        local: envfiles/caddy.env
    - path: /etc/bero_shape/collectstatic.env
      mode: 0644
      contents:
        local: envfiles/collectstatic.env
    - path: /etc/bero_shape/db.env
      mode: 0644
      contents:
        local: envfiles/db.env
    - path: /etc/bero_shape/django.env
      mode: 0644
      contents:
        local: envfiles/django.env
    - path: /etc/bero_shape/fcos-manifest.json
      mode: 0644
      contents:
        local: manifest.json
    - path: /etc/bero_shape/metabase.env
      mode: 0644
      contents:
        local: envfiles/metabase.env
    - path: /etc/bero_shape/migrate.env
      mode: 0644
      contents:
        local: envfiles/migrate.env
    - path: /etc/bero_shape/podman-ro-proxy.cfg
      mode: 0644
      contents:
        local: monitoring/podman-ro-proxy.cfg
    - path: /etc/bero_shape/redis.env
      mode: 0644
      contents:
        local: envfiles/redis.env
    - path: /etc/bero_shape/rq_worker.env
      mode: 0644
      contents:
        local: envfiles/rq_worker.env
    - path: /etc/bero_shape/zabbix-docker.conf
      mode: 0644
      contents:
        local: monitoring/zabbix-docker.conf
    - path: /etc/bero_shape/zabbix-userparams.conf
      mode: 0644
      contents:
        local: monitoring/zabbix-userparams.conf
    - path: /etc/containers/systemd/users/1001/bero_shape-restic-files-backup.container
      mode: 0644
      contents:
        local: quadlets/bero_shape-restic-files-backup.container
    - path: /etc/containers/systemd/users/1001/bero_shape_default.network
      mode: 0644
      contents:
        local: quadlets/bero_shape_default.network
    - path: /etc/containers/systemd/users/1001/caddy.container
      mode: 0644
      contents:
        local: quadlets/caddy.container
    - path: /etc/containers/systemd/users/1001/caddy_config.volume
      mode: 0644
      contents:
        local: quadlets/caddy_config.volume
    - path: /etc/containers/systemd/users/1001/collectstatic.container
      mode: 0644
      contents:
        local: quadlets/collectstatic.container
    - path: /etc/containers/systemd/users/1001/db.container
      mode: 0644
      contents:
        local: quadlets/db.container
    - path: /etc/containers/systemd/users/1001/django.container
      mode: 0644
      contents:
        local: quadlets/django.container
    - path: /etc/containers/systemd/users/1001/django_static.volume
      mode: 0644
      contents:
        local: quadlets/django_static.volume
    - path: /etc/containers/systemd/users/1001/metabase.container
      mode: 0644
      contents:
        local: quadlets/metabase.container
    - path: /etc/containers/systemd/users/1001/migrate.container
      mode: 0644
      contents:
        local: quadlets/migrate.container
    - path: /etc/containers/systemd/users/1001/podman-ro-proxy.container
      mode: 0644
      contents:
        local: quadlets/podman-ro-proxy.container
    - path: /etc/containers/systemd/users/1001/redis.container
      mode: 0644
      contents:
        local: quadlets/redis.container
    - path: /etc/containers/systemd/users/1001/redis_data.volume
      mode: 0644
      contents:
        local: quadlets/redis_data.volume
    - path: /etc/containers/systemd/users/1001/rq_worker.container
      mode: 0644
      contents:
        local: quadlets/rq_worker.container
    - path: /etc/containers/systemd/zabbix-agent2.container
      mode: 0644
      contents:
        local: quadlets/zabbix-agent2.container
    - path: /etc/tmpfiles.d/bero_shape.conf
      mode: 0644
      contents:
        local: monitoring/tmpfiles.conf
    - path: /var/home/core/.ssh/authorized_keys.d/dk
      mode: 0600
      user:
        name: core
      group:
        name: core
      contents:
        local: ssh/core.keys
    - path: /var/home/deploy/.config/bero_shape/30-bero_shape-pgbackrest-archive.conf
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: backup/postgres-archive.conf
    - path: /var/home/deploy/.config/bero_shape/50-bero_shape-managed.conf
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: backup/pgbackrest.conf
    - path: /var/home/deploy/.config/bero_shape/backup-status.sh
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: backup/backup-status.sh
    - path: /var/home/deploy/.config/bero_shape/caddy.json
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: caddy/caddy.json
    - path: /var/home/deploy/.config/systemd/user/bero_shape-backup-status.service
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/bero_shape-backup-status.service
    - path: /var/home/deploy/.config/systemd/user/bero_shape-backup-status.timer
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/bero_shape-backup-status.timer
    - path: /var/home/deploy/.config/systemd/user/bero_shape-pgbackrest-backup-full.timer
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/bero_shape-pgbackrest-backup-full.timer
    - path: /var/home/deploy/.config/systemd/user/bero_shape-pgbackrest-backup-incr.timer
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/bero_shape-pgbackrest-backup-incr.timer
    - path: /var/home/deploy/.config/systemd/user/bero_shape-pgbackrest-backup@.service
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/bero_shape-pgbackrest-backup@.service
    - path: /var/home/deploy/.config/systemd/user/bero_shape-restic-files-backup.timer
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/bero_shape-restic-files-backup.timer
    - path: /var/home/deploy/.config/systemd/user/caddy.socket
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/caddy.socket
    - path: /var/home/deploy/.ssh/authorized_keys.d/dk
      mode: 0600
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: ssh/deploy.keys

systemd:
  units:
    # Rootless quadlets wait for the system network-online.target, which nothing pulls in
    # on a host without system quadlets: without this, the wait times out (90 s) at boot.
    - name: multi-user.target
      dropins:
        - name: 10-network-online.conf
          contents: |
            [Unit]
            Wants=network-online.target
    # Only fcos.admin_keys log in as core: afterburn would add the droplet's DigitalOcean
    # account keys to it at every boot.
    - name: afterburn-sshkeys@core.service
      mask: true
