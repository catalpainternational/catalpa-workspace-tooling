# Generated by `dk staging fcos render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
# Schedule from dk's restic-files-backup.timer template (the host's time zone).
[Unit]
Description=restic backup of django_media, django_private_uploads

[Timer]
OnCalendar=daily
Persistent=true
Unit=swlt-restic-files-backup.service

[Install]
WantedBy=timers.target
