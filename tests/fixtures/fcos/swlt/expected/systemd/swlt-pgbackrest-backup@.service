# Generated by `dk staging fcos render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
# pgBackRest backup of type %i (full, incr or diff) inside db. By hand:
#   systemctl --user start swlt-pgbackrest-backup@full.service
[Unit]
Description=pgBackRest %i backup
Requires=db.service
After=db.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec -u postgres db pgbackrest --log-level-console=info backup --type=%i
