# Generated by `dk staging render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
# Schedule from dk's pgbackrest-backup-diff.timer template (the host's time zone).
[Unit]
Description=pgBackRest diff backup

[Timer]
OnCalendar=Mon..Sat *-*-* 03:15:00
Persistent=true
Unit=swlt-pgbackrest-backup@diff.service

[Install]
WantedBy=timers.target
