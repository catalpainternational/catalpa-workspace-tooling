{
  "apps": {
    "http": {
      "servers": {
        "fd_http_redirect": {
          "listen": [
            "fd/3"
          ],
          "listen_protocols": [
            [
              "h1"
            ]
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ]
            }
          ]
        },
        "srv0": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            "fd/4",
            "fdgram/5"
          ],
          "listen_protocols": [
            [
              "h1",
              "h2"
            ],
            [
              "h3"
            ]
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "django:8000"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "https://staging.swlt.example"
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
