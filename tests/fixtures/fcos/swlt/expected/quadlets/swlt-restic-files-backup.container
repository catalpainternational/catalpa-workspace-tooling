# Generated by `dk staging render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=restic backup of django_media, django_private_uploads
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=swlt-restic-files-backup
Image=docker.io/restic/restic:0.17.3
UIDMap=0:20000:5000
GIDMap=0:20000:5000
Secret=restic_write_password,type=env,target=RESTIC_PASSWORD
Secret=restic_write_repository,type=env,target=RESTIC_REPOSITORY
Volume=/var/mnt/data/django_media:/backup/django_media:ro,z
Volume=/var/mnt/data/django_private_uploads:/backup/django_private_uploads:ro,z
# restic's cache, so each run doesn't download the repository index again.
Volume=swlt_shape_restic_cache:/root/.cache/restic
# A fixed --host: the container's own hostname changes every run, so restic would
# find no parent snapshot and `forget` couldn't group snapshots.
Exec=backup --host swlt-shape-staging /backup/django_media /backup/django_private_uploads
# Output once, as the unit's (journalctl -u), through podman's attached stdout: a
# one-shot needs no `podman logs`. Podman's journald driver logged every line twice,
# and passthrough logs as the container's ID-range uid, which the account can't read.
LogDriver=none

[Service]
Type=oneshot
TimeoutStartSec=3600
