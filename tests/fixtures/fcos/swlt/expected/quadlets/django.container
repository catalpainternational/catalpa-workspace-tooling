# Generated by `dk staging fcos render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=swlt_shape django
Requires=migrate.service
After=migrate.service
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=django
Image=ghcr.io/example/swlt-django:v0.16.1
Network=swlt_shape_default.network
UIDMap=0:20000:5000
GIDMap=0:20000:5000
EnvironmentFile=/etc/swlt_shape/django.env
Secret=django_secret_key,type=env,target=DJANGO_SECRET_KEY
Secret=site_auth,type=env,target=SITE_AUTH
Volume=/var/mnt/data/django_media:/app/media:z
Volume=/var/mnt/data/django_private_uploads:/app/private_uploads:Z
Tmpfs=/tmp
RunInit=true

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
