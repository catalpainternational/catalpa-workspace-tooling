# Generated by `dk staging fcos render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=swlt_shape rqscheduler
Wants=redis.service
After=redis.service

[Container]
ContainerName=rqscheduler
Image=ghcr.io/example/swlt-django:v0.16.1
Network=swlt_shape_default.network
UIDMap=0:20000:5000
GIDMap=0:20000:5000
EnvironmentFile=/etc/swlt_shape/rqscheduler.env
Secret=django_secret_key,type=env,target=DJANGO_SECRET_KEY
Secret=site_auth,type=env,target=SITE_AUTH
Exec=python manage.py rqscheduler --interval 60

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
