# Generated by `dk staging fcos render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=swlt_shape redis

[Container]
ContainerName=redis
Image=docker.io/library/redis:8-alpine
Network=swlt_shape_default.network
UIDMap=0:30000:5000
GIDMap=0:30000:5000
EnvironmentFile=/etc/swlt_shape/redis.env

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
