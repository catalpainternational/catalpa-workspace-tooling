# Generated by `dk staging render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=swlt_shape caddy
Requires=caddy.socket
Wants=django.service
After=caddy.socket django.service
RequiresMountsFor=/var/mnt/data

[Container]
ContainerName=caddy
Image=ghcr.io/example/swlt-caddy:v0.16.1
Network=swlt_shape_default.network
UIDMap=0:10000:5000
GIDMap=0:10000:5000
EnvironmentFile=/etc/swlt_shape/caddy.env
Secret=site_auth,type=env,target=SITE_AUTH
Volume=/var/mnt/data/caddy_data:/data:Z
Volume=/var/mnt/data/django_media:/srv/media:ro,z
Volume=/var/home/deploy/.config/swlt_shape/caddy.json:/etc/caddy/caddy.json:ro,Z
Exec=run --config /etc/caddy/caddy.json

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
