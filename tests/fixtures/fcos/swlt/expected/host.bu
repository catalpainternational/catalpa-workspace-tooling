# Generated by `dk staging render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
# Compile in this directory:
#   podman run --rm -v "$PWD":/work:Z -w /work quay.io/coreos/butane:release \
#     --strict --files-dir . host.bu > host.ign
variant: fcos
version: 1.6.0

passwd:
  users:
    # Admins: passwordless sudo (FCOS default), so root-equivalent. Keys: fcos.admin_keys,
    # installed below as ~/.ssh/authorized_keys.d/dk (so `dk <env> apply` can change them).
    - name: core
    # Runs the stack (rootless Podman) and is what dk connects as. Keys:
    # fcos.ssh_authorized_keys. No sudo, no extra groups. A fixed uid: the quadlets live in
    # /etc/containers/systemd/users/<uid>/.
    - name: deploy
      uid: 1001

storage:
  directories:
    - path: /var/mnt/data
      mode: 0755
    # Bind volumes, owned by the host uid of the user that writes them (see manifest.json).
    - path: /var/mnt/data/caddy_data
      mode: 0700
      user:
        id: 599823
      group:
        id: 599823
    - path: /var/mnt/data/django_media
      mode: 0755
      user:
        id: 609823
      group:
        id: 609823
    - path: /var/mnt/data/django_private_uploads
      mode: 0700
      user:
        id: 609823
      group:
        id: 609823
    - path: /var/mnt/data/postgres_data
      mode: 0700
      user:
        id: 605822
      group:
        id: 605822
    - path: /etc/swlt_shape
      mode: 0755
    # Root-owned: deploy runs these quadlets but can't edit them.
    - path: /etc/containers/systemd/users/1001
      mode: 0755
    # core's and deploy's own directories. Ignition makes missing parents as root, so
    # each level is listed.
    - path: /var/home/core/.ssh
      mode: 0700
      user:
        name: core
      group:
        name: core
    - path: /var/home/core/.ssh/authorized_keys.d
      mode: 0700
      user:
        name: core
      group:
        name: core
    - path: /var/home/deploy/.config
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/swlt_shape
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/sockets.target.wants
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.ssh
      mode: 0700
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.ssh/authorized_keys.d
      mode: 0700
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/containers
      mode: 0700
      user:
        name: deploy
      group:
        name: deploy

  links:
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/UTC
      overwrite: true
    # Enable deploy's units (systemctl --user enable).
    - path: /var/home/deploy/.config/systemd/user/sockets.target.wants/caddy.socket
      target: ../caddy.socket
      user:
        name: deploy
      group:
        name: deploy
    # Docker-compatible API for dk.
    - path: /var/home/deploy/.config/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants/swlt-pgbackrest-backup-diff.timer
      target: ../swlt-pgbackrest-backup-diff.timer
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants/swlt-pgbackrest-backup-full.timer
      target: ../swlt-pgbackrest-backup-full.timer
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants/swlt-restic-files-backup.timer
      target: ../swlt-restic-files-backup.timer
      user:
        name: deploy
      group:
        name: deploy

  files:
    # Pinned subordinate IDs (what useradd picks anyway), so a change in that order can't
    # move the data directories' owners.
    - path: /etc/subuid
      mode: 0644
      overwrite: true
      contents:
        inline: |
          core:524288:65536
          deploy:589824:65536
    - path: /etc/subgid
      mode: 0644
      overwrite: true
      contents:
        inline: |
          core:524288:65536
          deploy:589824:65536
    # The DO image writes /etc/hostname before Ignition runs.
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: |
          swlt-shape-staging
    # OS updates and their reboot only in this window (UTC).
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [updates.periodic]
          time_zone = "UTC"

          [[updates.periodic.window]]
          days = [ "Sat", "Sun" ]
          start_time = "01:00"
          length_minutes = 90
    # deploy's systemd (and so the stack) starts at boot with nobody logged in.
    - path: /var/lib/systemd/linger/deploy
      mode: 0644
    # Lets deploy's systemd open 80 and 443 for the edge (caddy.socket).
    - path: /etc/sysctl.d/50-unprivileged-ports.conf
      mode: 0644
      contents:
        inline: |
          net.ipv4.ip_unprivileged_port_start = 80
    # Keep rootless Podman's registry login across reboots (default: /run/user/<uid>).
    - path: /etc/systemd/user.conf.d/10-registry-auth.conf
      mode: 0644
      contents:
        inline: |
          [Manager]
          DefaultEnvironment=REGISTRY_AUTH_FILE=/var/home/deploy/.config/containers/auth.json
    # Hardening: keys only, no root, few tries. Read before FCOS's own drop-ins (first
    # value wins).
    - path: /etc/ssh/sshd_config.d/10-hardening.conf
      mode: 0644
      contents:
        inline: |
          PasswordAuthentication no
          KbdInteractiveAuthentication no
          PermitRootLogin no
          MaxAuthTries 3
          X11Forwarding no
          AllowUsers core deploy
    # Hardening: no LLMNR or mDNS (resolved answers on 5355 by default).
    - path: /etc/systemd/resolved.conf.d/10-no-llmnr.conf
      mode: 0644
      contents:
        inline: |
          [Resolve]
          LLMNR=no
          MulticastDNS=no
    # Generated files (manifest.json's install map).
    - path: /etc/containers/systemd/users/1001/caddy.container
      mode: 0644
      contents:
        local: quadlets/caddy.container
    - path: /etc/containers/systemd/users/1001/db.container
      mode: 0644
      contents:
        local: quadlets/db.container
    - path: /etc/containers/systemd/users/1001/django-task.container
      mode: 0644
      contents:
        local: quadlets/django-task.container
    - path: /etc/containers/systemd/users/1001/django.container
      mode: 0644
      contents:
        local: quadlets/django.container
    - path: /etc/containers/systemd/users/1001/mailpit.container
      mode: 0644
      contents:
        local: quadlets/mailpit.container
    - path: /etc/containers/systemd/users/1001/migrate.container
      mode: 0644
      contents:
        local: quadlets/migrate.container
    - path: /etc/containers/systemd/users/1001/redis.container
      mode: 0644
      contents:
        local: quadlets/redis.container
    - path: /etc/containers/systemd/users/1001/rqscheduler.container
      mode: 0644
      contents:
        local: quadlets/rqscheduler.container
    - path: /etc/containers/systemd/users/1001/swlt-restic-files-backup.container
      mode: 0644
      contents:
        local: quadlets/swlt-restic-files-backup.container
    - path: /etc/containers/systemd/users/1001/swlt_shape_default.network
      mode: 0644
      contents:
        local: quadlets/swlt_shape_default.network
    - path: /etc/swlt_shape/caddy.env
      mode: 0644
      contents:
        local: envfiles/caddy.env
    - path: /etc/swlt_shape/db.env
      mode: 0644
      contents:
        local: envfiles/db.env
    - path: /etc/swlt_shape/django.env
      mode: 0644
      contents:
        local: envfiles/django.env
    - path: /etc/swlt_shape/fcos-manifest.json
      mode: 0644
      contents:
        local: manifest.json
    - path: /etc/swlt_shape/mailpit.env
      mode: 0644
      contents:
        local: envfiles/mailpit.env
    - path: /etc/swlt_shape/migrate.env
      mode: 0644
      contents:
        local: envfiles/migrate.env
    - path: /etc/swlt_shape/redis.env
      mode: 0644
      contents:
        local: envfiles/redis.env
    - path: /etc/swlt_shape/rqscheduler.env
      mode: 0644
      contents:
        local: envfiles/rqscheduler.env
    - path: /var/home/core/.ssh/authorized_keys.d/dk
      mode: 0600
      user:
        name: core
      group:
        name: core
      contents:
        local: ssh/core.keys
    - path: /var/home/deploy/.config/swlt_shape/30-swlt_shape-pgbackrest-archive.conf
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: backup/postgres-archive.conf
    - path: /var/home/deploy/.config/swlt_shape/50-swlt_shape-managed.conf
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: backup/pgbackrest.conf
    - path: /var/home/deploy/.config/swlt_shape/caddy.json
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: caddy/caddy.json
    - path: /var/home/deploy/.config/systemd/user/caddy.socket
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/caddy.socket
    - path: /var/home/deploy/.config/systemd/user/swlt-pgbackrest-backup-diff.timer
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/swlt-pgbackrest-backup-diff.timer
    - path: /var/home/deploy/.config/systemd/user/swlt-pgbackrest-backup-full.timer
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/swlt-pgbackrest-backup-full.timer
    - path: /var/home/deploy/.config/systemd/user/swlt-pgbackrest-backup@.service
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/swlt-pgbackrest-backup@.service
    - path: /var/home/deploy/.config/systemd/user/swlt-restic-files-backup.timer
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: systemd/swlt-restic-files-backup.timer
    - path: /var/home/deploy/.ssh/authorized_keys.d/dk
      mode: 0600
      user:
        name: deploy
      group:
        name: deploy
      contents:
        local: ssh/deploy.keys

systemd:
  units:
    # Rootless quadlets wait for the system network-online.target, which nothing pulls in
    # on a host without system quadlets: without this, the wait times out (90 s) at boot.
    - name: multi-user.target
      dropins:
        - name: 10-network-online.conf
          contents: |
            [Unit]
            Wants=network-online.target
    # Only fcos.admin_keys log in as core: afterburn would add the droplet's DigitalOcean
    # account keys to it at every boot.
    - name: afterburn-sshkeys@core.service
      mask: true
