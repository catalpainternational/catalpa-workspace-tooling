# The colour's web, units version 2: answers /healthz once its database answers.
[Unit]
PartOf=notes@%i.target
BindsTo=notes-pod@%i.service
After=notes-migrate@%i.service
Requires=notes-migrate@%i.service

[Container]
ContainerName=notes-%i-web
Image=10.0.2.2:15000/notes-bluegreen:1
PodmanArgs=--pod=notes-%i
Environment=UNITS_VERSION=2 APP_VERSION=1
Secret=notes-%i-dotenv,type=mount,target=/app/.env,mode=0444
Exec=serve

[Service]
Restart=on-failure
