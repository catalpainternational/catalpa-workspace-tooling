# Generated by `dk host shared-1 render` from host.yaml. Don't edit: change host.yaml.
# Compile in this directory (or `dk host <dir> ignition`):
#   podman run --rm -v "$PWD":/work:Z -w /work quay.io/coreos/butane:release \
#     --strict --files-dir . host.bu > host.ign
variant: fcos
version: 1.6.0

passwd:
  users:
    # Admins: passwordless sudo (FCOS default). No app runs here.
    - name: core
    # One account per env (or per site and colour), each made only here, at first boot.
    - name: deploy
      uid: 1001
    - name: site
      uid: 1002
    - name: blue
      uid: 1003
    - name: green
      uid: 1004
    - name: edge
      uid: 1031

storage:
  directories:
    - path: /var/mnt/data
      mode: 0755
    - path: /var/mnt/data/deploy
      mode: 0755
    - path: /var/mnt/data/site
      mode: 0755
    - path: /var/mnt/data/blue
      mode: 0755
    - path: /var/mnt/data/green
      mode: 0755
    # deploy's quadlets: root's, readable by deploy only.
    - path: /etc/containers/systemd/users/1001
      mode: 0750
      group:
        name: deploy
    - path: /var/home/deploy/.config
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/sockets.target.wants
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/timers.target.wants
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/systemd/user/default.target.wants
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/environment.d
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.config/containers
      mode: 0700
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.local
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.local/state
      mode: 0755
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.ssh
      mode: 0700
      user:
        name: deploy
      group:
        name: deploy
    - path: /var/home/deploy/.ssh/authorized_keys.d
      mode: 0700
      user:
        name: deploy
      group:
        name: deploy
    # site's quadlets: root's, readable by site only.
    - path: /etc/containers/systemd/users/1002
      mode: 0750
      group:
        name: site
    - path: /var/home/site/.config
      mode: 0755
      user:
        name: site
      group:
        name: site
    - path: /var/home/site/.config/systemd
      mode: 0755
      user:
        name: site
      group:
        name: site
    - path: /var/home/site/.config/systemd/user
      mode: 0755
      user:
