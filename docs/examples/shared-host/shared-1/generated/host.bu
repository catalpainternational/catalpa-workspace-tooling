      mode: 0755
      user:
        name: blue
      group:
        name: blue
    - path: /var/home/blue/.config/systemd/user/timers.target.wants
      mode: 0755
      user:
        name: blue
      group:
        name: blue
    - path: /var/home/blue/.config/systemd/user/default.target.wants
      mode: 0755
      user:
        name: blue
      group:
        name: blue
    - path: /var/home/blue/.config/environment.d
      mode: 0755
      user:
        name: blue
      group:
        name: blue
    - path: /var/home/blue/.config/containers
      mode: 0700
      user:
        name: blue
      group:
        name: blue
    - path: /var/home/blue/.local
      mode: 0755
      user:
        name: blue
      group:
        name: blue
    - path: /var/home/blue/.local/state
      mode: 0755
      user:
        name: blue
      group:
        name: blue
    - path: /var/home/blue/.ssh
      mode: 0700
      user:
        name: blue
      group:
        name: blue
    - path: /var/home/blue/.ssh/authorized_keys.d
      mode: 0700
      user:
        name: blue
      group:
        name: blue
    # green's quadlets: root's, readable by green only.
    - path: /etc/containers/systemd/users/1004
      mode: 0750
      group:
        name: green
    - path: /var/home/green/.config
      mode: 0755
      user:
        name: green
      group:
        name: green
    - path: /var/home/green/.config/systemd
      mode: 0755
      user:
        name: green
      group:
