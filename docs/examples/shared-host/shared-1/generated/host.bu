    - path: /var/home/green/.ssh/authorized_keys.d
      mode: 0700
      user:
        name: green
      group:
        name: green
    # edge's quadlets: root's, readable by edge only.
    - path: /etc/containers/systemd/users/1031
      mode: 0750
      group:
        name: edge
    - path: /var/home/edge/.config
      mode: 0755
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.config/systemd
      mode: 0755
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.config/systemd/user
      mode: 0755
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.config/systemd/user/sockets.target.wants
      mode: 0755
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.config/systemd/user/timers.target.wants
      mode: 0755
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.config/systemd/user/default.target.wants
      mode: 0755
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.config/environment.d
      mode: 0755
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.config/containers
      mode: 0700
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.local
      mode: 0755
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.local/state
      mode: 0755
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.ssh
      mode: 0700
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.ssh/authorized_keys.d
      mode: 0700
      user:
        name: edge
      group:
        name: edge
    - path: /var/home/edge/.config/edge
      mode: 0755
      user:
        name: edge
      group:
        name: edge
    - path: /etc/dk
      mode: 0755

  links:
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/Asia/Dili
      overwrite: true
    # Docker-compatible API for dk.
    - path: /var/home/deploy/.config/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user:
        name: deploy
      group:
        name: deploy
    # Docker-compatible API for dk.
    - path: /var/home/site/.config/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user:
        name: site
      group:
        name: site
    # Docker-compatible API for dk.
    - path: /var/home/blue/.config/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user:
        name: blue
      group:
        name: blue
    # Docker-compatible API for dk.
    - path: /var/home/green/.config/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
      user:
        name: green
      group:
        name: green
    - path: /var/home/edge/.config/systemd/user/sockets.target.wants/edge.socket
      target: ../edge.socket
      user:
        name: edge
      group:
        name: edge

  files:
    # Pinned subordinate IDs, from each account's slot.
    - path: /etc/subuid
      mode: 0644
      overwrite: true
      contents:
        inline: |
          core:524288:65536
          deploy:589824:65536
          site:655360:65536
          blue:720896:65536
          green:786432:65536
          edge:2555904:65536
    - path: /etc/subgid
      mode: 0644
      overwrite: true
      contents:
        inline: |
          core:524288:65536
          deploy:589824:65536
          site:655360:65536
          blue:720896:65536
          green:786432:65536
          edge:2555904:65536
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: |
          shared-1
    # OS updates and their reboot only in this window (Asia/Dili).
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [updates.periodic]
          time_zone = "Asia/Dili"

          [[updates.periodic.window]]
          days = [ "Sun" ]
          start_time = "02:00"
          length_minutes = 60
    # Lets the edge's systemd open 80 and 443 (edge.socket).
    - path: /etc/sysctl.d/50-unprivileged-ports.conf
      mode: 0644
      contents:
        inline: |
          net.ipv4.ip_unprivileged_port_start = 80
    # Hardening: keys only, no root, few tries; only these accounts log in.
    - path: /etc/ssh/sshd_config.d/10-hardening.conf
      mode: 0644
      contents:
        inline: |
          PasswordAuthentication no
          KbdInteractiveAuthentication no
          PermitRootLogin no
          MaxAuthTries 3
          X11Forwarding no
          AllowUsers core deploy site blue green
    # Hardening: no LLMNR or mDNS.
    - path: /etc/systemd/resolved.conf.d/10-no-llmnr.conf
      mode: 0644
      contents:
        inline: |
          [Resolve]
          LLMNR=no
          MulticastDNS=no
    # admin_keys: admins, root through sudo.
    - path: /var/home/core/.ssh/authorized_keys.d/dk
      mode: 0600
      user:
        name: core
      group:
        name: core
      contents:
        inline: |
          ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH8Ao5k/cvLSXdOdbJ3YF3J8M1wKPUdp6eptUEpAv8cW spike-multienv
    - path: /etc/dk/loopback.nft
      mode: 0644
      contents:
        inline: |
          # Loopback ports per account: only the account's own env and the edge may connect.
          table inet dk_loopback
          delete table inet dk_loopback
          table inet dk_loopback {
          	chain output {
          		type filter hook output priority 0; policy accept;
          		oif "lo" ip daddr 127.0.0.1 tcp dport 20010-20019 meta skuid != { 1001, 1031 } counter reject with tcp reset  # deploy
          		oif "lo" ip daddr 127.0.0.1 tcp dport 20020-20029 meta skuid != { 1002, 1003, 1004, 1031 } counter reject with tcp reset  # site
          		oif "lo" ip daddr 127.0.0.1 tcp dport 20030-20039 meta skuid != { 1002, 1003, 1004, 1031 } counter reject with tcp reset  # blue
          		oif "lo" ip daddr 127.0.0.1 tcp dport 20040-20049 meta skuid != { 1002, 1003, 1004, 1031 } counter reject with tcp reset  # green
          	}
          }
    # insecure_registries: plain-HTTP test registries.
    - path: /etc/containers/registries.conf.d/50-dk-insecure.conf
      mode: 0644
      contents:
        inline: |
          [[registry]]
          location = "10.0.2.2:15000"
          insecure = true
    # deploy's systemd starts at boot with nobody logged in.
    - path: /var/lib/systemd/linger/deploy
      mode: 0644
    - path: /var/home/deploy/.config/environment.d/10-registry-auth.conf
      mode: 0644
      user:
        name: deploy
      group:
        name: deploy
      contents:
        inline: |
          REGISTRY_AUTH_FILE=/var/home/deploy/.config/containers/auth.json
    # site's systemd starts at boot with nobody logged in.
    - path: /var/lib/systemd/linger/site
      mode: 0644
    - path: /var/home/site/.config/environment.d/10-registry-auth.conf
      mode: 0644
      user:
        name: site
      group:
        name: site
      contents:
        inline: |
          REGISTRY_AUTH_FILE=/var/home/site/.config/containers/auth.json
    # blue's systemd starts at boot with nobody logged in.
    - path: /var/lib/systemd/linger/blue
      mode: 0644
    - path: /var/home/blue/.config/environment.d/10-registry-auth.conf
      mode: 0644
      user:
        name: blue
      group:
        name: blue
      contents:
        inline: |
          REGISTRY_AUTH_FILE=/var/home/blue/.config/containers/auth.json
    # green's systemd starts at boot with nobody logged in.
    - path: /var/lib/systemd/linger/green
      mode: 0644
    - path: /var/home/green/.config/environment.d/10-registry-auth.conf
      mode: 0644
      user:
        name: green
      group:
        name: green
      contents:
        inline: |
          REGISTRY_AUTH_FILE=/var/home/green/.config/containers/auth.json
    # edge's systemd starts at boot with nobody logged in.
    - path: /var/lib/systemd/linger/edge
      mode: 0644
    - path: /var/home/edge/.config/environment.d/10-registry-auth.conf
      mode: 0644
      user:
        name: edge
      group:
        name: edge
      contents:
        inline: |
          REGISTRY_AUTH_FILE=/var/home/edge/.config/containers/auth.json
    # ssh_authorized_keys: dk and CI, no sudo.
    - path: /var/home/deploy/.ssh/authorized_keys.d/dk
      mode: 0600
      user:
        name: deploy
      group:
        name: deploy
      contents:
        inline: |
          ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH8Ao5k/cvLSXdOdbJ3YF3J8M1wKPUdp6eptUEpAv8cW spike-multienv
    # ssh_authorized_keys: dk and CI, no sudo.
    - path: /var/home/site/.ssh/authorized_keys.d/dk
      mode: 0600
      user:
        name: site
      group:
        name: site
      contents:
        inline: |
          ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH8Ao5k/cvLSXdOdbJ3YF3J8M1wKPUdp6eptUEpAv8cW spike-multienv
    # ssh_authorized_keys: dk and CI, no sudo.
    - path: /var/home/blue/.ssh/authorized_keys.d/dk
      mode: 0600
      user:
        name: blue
      group:
        name: blue
      contents:
        inline: |
          ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH8Ao5k/cvLSXdOdbJ3YF3J8M1wKPUdp6eptUEpAv8cW spike-multienv
    # ssh_authorized_keys: dk and CI, no sudo.
    - path: /var/home/green/.ssh/authorized_keys.d/dk
      mode: 0600
      user:
        name: green
      group:
        name: green
      contents:
        inline: |
          ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH8Ao5k/cvLSXdOdbJ3YF3J8M1wKPUdp6eptUEpAv8cW spike-multienv
    # The shared edge.
    - path: /etc/containers/systemd/users/1031/edge.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=the shared edge: TLS for every name on the host, each to its account
          Requires=edge.socket
          After=edge.socket

          [Container]
          ContainerName=edge
          Image=docker.io/library/caddy:2.11.4-alpine
          # The host's network: each account listens on 127.0.0.1:<its port>.
          Network=host
          Volume=/var/home/edge/.config/edge/caddy.json:/etc/caddy/caddy.json:ro,Z
          Volume=edge-data:/data:Z
          Exec=caddy run --config /etc/caddy/caddy.json

          [Service]
          Restart=always

          [Install]
          WantedBy=default.target
    - path: /var/home/edge/.config/systemd/user/edge.socket
      mode: 0644
      user:
        name: edge
      group:
        name: edge
      contents:
        inline: |
          [Unit]
          Description=the shared edge's sockets (80, 443, 443/udp)

          [Socket]
          # Passed to the container in this order: fd 3, fd 4, fd 5 (see caddy.json).
          BindIPv6Only=both
          ListenStream=[::]:80
          ListenStream=[::]:443
          ListenDatagram=[::]:443

          [Install]
          WantedBy=sockets.target
    - path: /var/home/edge/.config/edge/caddy.json
      mode: 0644
      user:
        name: edge
      group:
        name: edge
      contents:
        local: edge/caddy.json

systemd:
  units:
    # Rootless quadlets wait for network-online.target, which nothing else pulls in.
    - name: multi-user.target
      dropins:
        - name: 10-network-online.conf
          contents: |
            [Unit]
            Wants=network-online.target
    - name: dk-loopback-firewall.service
      enabled: true
      contents: |
        [Unit]
        Description=dk: each account's loopback ports for its own env only
        Before=network-pre.target
        Wants=network-pre.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/nft -f /etc/dk/loopback.nft

        [Install]
        WantedBy=multi-user.target
    # Only admin_keys log in as core: afterburn would add the droplet's account keys.
    - name: afterburn-sshkeys@core.service
      mask: true
