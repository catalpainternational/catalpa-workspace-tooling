      user:
        name: site
      group:
        name: site
    - path: /var/home/site/.local
      mode: 0755
      user:
        name: site
      group:
        name: site
    - path: /var/home/site/.local/state
      mode: 0755
      user:
        name: site
      group:
        name: site
    - path: /var/home/site/.ssh
      mode: 0700
      user:
        name: site
      group:
        name: site
    - path: /var/home/site/.ssh/authorized_keys.d
      mode: 0700
      user:
        name: site
      group:
        name: site
    # blue's quadlets: root's, readable by blue only.
    - path: /etc/containers/systemd/users/1003
      mode: 0750
      group:
        name: blue
    - path: /var/home/blue/.config
      mode: 0755
      user:
        name: blue
      group:
