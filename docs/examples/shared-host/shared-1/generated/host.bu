    - path: /var/home/green/.config/systemd/user/default.target.wants
      mode: 0755
      user:
        name: green
      group:
        name: green
    - path: /var/home/green/.config/environment.d
      mode: 0755
      user:
        name: green
      group:
        name: green
    - path: /var/home/green/.config/containers
      mode: 0700
      user:
        name: green
      group:
        name: green
    - path: /var/home/green/.local
      mode: 0755
      user:
        name: green
      group:
        name: green
    - path: /var/home/green/.local/state
      mode: 0755
      user:
        name: green
