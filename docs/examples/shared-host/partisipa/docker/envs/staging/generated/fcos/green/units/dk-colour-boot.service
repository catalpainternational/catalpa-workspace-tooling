# Generated by dk: at boot, start this colour once the site account's ports answer.
[Unit]
Description=dk: start this colour after the site (another account)

[Service]
Type=oneshot
TimeoutStartSec=15min
ExecStart=/bin/bash -c 'for p in 20020 20021; do until (exec 3<>/dev/tcp/127.0.0.1/$p) 2>/dev/null; do sleep 2; done; done'
ExecStart=/usr/bin/systemctl --user start --no-block notes@staging-green.target

[Install]
WantedBy=default.target
