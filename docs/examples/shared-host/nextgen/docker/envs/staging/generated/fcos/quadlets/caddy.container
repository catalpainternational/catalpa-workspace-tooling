# Generated by `dk staging render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=nextgen caddy
Requires=caddy.socket
Wants=web.service
After=caddy.socket web.service
RequiresMountsFor=/var/mnt/data/deploy

[Container]
ContainerName=caddy
Image=10.0.2.2:15000/demo-caddy:spike
Network=nextgen_staging_default.network
UIDMap=0:10000:5000
GIDMap=0:10000:5000
EnvironmentFile=/etc/nextgen/staging/caddy.env
Volume=/var/mnt/data/deploy/caddy_data:/data:Z
Volume=/var/home/deploy/.config/nextgen/caddy.json:/etc/caddy/caddy.json:ro,Z
Exec=caddy run --config /etc/caddy/caddy.json

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
