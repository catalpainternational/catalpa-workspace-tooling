# Generated by `dk staging render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=nextgen web
Requires=db.service
After=db.service

[Container]
ContainerName=web
Image=docker.io/traefik/whoami:v1.10
Network=nextgen_staging_default.network
UIDMap=0:20000:5000
GIDMap=0:20000:5000
EnvironmentFile=/etc/nextgen/staging/web.env

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
