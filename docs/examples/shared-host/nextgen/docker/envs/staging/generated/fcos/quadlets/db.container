# Generated by `dk staging render` from compose.yml. Do not edit: change the compose file or info.yaml and render again.
[Unit]
Description=nextgen db
RequiresMountsFor=/var/mnt/data/deploy

[Container]
ContainerName=db
Image=docker.io/library/postgres:17-alpine
Network=nextgen_staging_default.network
UIDMap=0:15000:5000
GIDMap=0:15000:5000
EnvironmentFile=/etc/nextgen/staging/db.env
Secret=postgres_password,type=env,target=POSTGRES_PASSWORD
Volume=/var/mnt/data/deploy/pgdata:/var/lib/postgresql/data:Z
HealthCmd=pg_isready -U postgres
HealthInterval=3s
HealthTimeout=5s
HealthRetries=10
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
