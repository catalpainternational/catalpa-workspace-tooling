# Example environment for systemd units (copy to e.g. @CONFIG_DIR@/pgbackrest-backup.env).
# Reference from *-pgbackrest-backup-*.service via EnvironmentFile=.
# Running Postgres container on the Docker host (docker ps). Compose v2 often: ${COMPOSE_PROJECT_NAME}_db_1
PGBR_DB_CONTAINER=app_db_1
# Stanza must match PGBR_S3_WRITE_STANZA / PGBR_S3_READ_STANZA used when materializing pgBackRest config.
PGBR_STANZA=main

# Optional: more detail in journald (docker exec stdout/stderr). Typical: info or detail.
# PGBR_LOG_LEVEL_CONSOLE=info
# PGBR_LOG_LEVEL_STDERR=warn
