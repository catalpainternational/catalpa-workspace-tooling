# Example environment for systemd units (copy to e.g. @CONFIG_DIR@/restic-files-backup.env).
# Reference from *-restic-files-backup.service via EnvironmentFile=.
#
# Must match the Compose project that owns the django_media volume (see compose.yml / info.yaml env).
COMPOSE_PROJECT_NAME=my_compose_project

# Restic repository URL (S3 example — use a different prefix than pgBackRest repo1-path).
RESTIC_REPOSITORY=s3:s3.amazonaws.com/my-bucket/my-project-restic-files
RESTIC_PASSWORD=changeme-strong-repo-password

# Optional: override image (default restic/restic:0.17.3 in restic-files-backup.sh).
# RESTIC_IMAGE=restic/restic:0.17.3

# S3-compatible object storage (restic maps these to AWS_* inside the container).
# Region may also be embedded in RESTIC_REPOSITORY.
# RESTIC_S3_ACCESS_KEY_ID=
# RESTIC_S3_SECRET_ACCESS_KEY=
# RESTIC_S3_DEFAULT_REGION=
# Optional (temporary credentials):
# RESTIC_S3_SESSION_TOKEN=
