# Template: copy to /etc/systemd/system/ and adjust paths.
# Schedules via indmo-pgbackrest-backup-full.timer (install separately).
#
# Prerequisites (see DEPLOY.md — pgBackRest systemd backups):
# - WRITE mode (PGBR_S3_WRITE_*) and db container running
# - PGBR_DB_CONTAINER and PGBR_STANZA in EnvironmentFile (no compose file required on host)
# - PGBR_STANZA matches deploy credentials / 50-indmo-managed.conf
#
[Unit]
Description=pgBackRest full backup (docker exec into db container)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/indmo/pgbackrest-backup.env
ExecStart=/opt/indmo/pgbackrest-backup.sh full
User=root
Group=root

[Install]
WantedBy=multi-user.target
