# Rendered by dk bkp_db install-systemd (see README_SYSTEMD.md).
# Example: daily incremental backup 02:30 UTC (after WAL archive cadence).
#
[Unit]
Description=Timer for pgBackRest incremental backup

[Timer]
# Example: 02:30 UTC every day (adjust for your timezone / load window)
OnCalendar=*-*-* 02:30:00
Persistent=true

[Install]
WantedBy=timers.target
