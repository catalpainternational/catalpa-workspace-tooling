#!/usr/bin/env bash
# AWS CLI pointed at local Garage (127.0.0.1:3900).
# Installed on dc_backup_docker_host via `dk <env> dc-backup provision`.
set -euo pipefail

ENV_FILE="@CONFIG_DIR@/garage-s3.env"
if [[ ! -f "${ENV_FILE}" ]]; then
  echo "Missing ${ENV_FILE}; re-run: dk <env> dc-backup provision" >&2
  exit 1
fi
# shellcheck disable=SC1090
set -a
# shellcheck source=/dev/null
source "${ENV_FILE}"
set +a

: "${AWS_ACCESS_KEY_ID:?set AWS_ACCESS_KEY_ID in garage-s3.env}"
: "${AWS_SECRET_ACCESS_KEY:?set AWS_SECRET_ACCESS_KEY in garage-s3.env}"

ENDPOINT="${AWS_ENDPOINT_URL:-http://127.0.0.1:3900}"
REGION="${AWS_DEFAULT_REGION:-garage}"
export AWS_DEFAULT_REGION="${REGION}"

if command -v aws >/dev/null 2>&1; then
  exec aws --endpoint-url "${ENDPOINT}" "$@"
fi

IMAGE="${AWS_CLI_IMAGE:-amazon/aws-cli:2.22.35}"
exec docker run --rm --network host \
  -e AWS_ACCESS_KEY_ID \
  -e AWS_SECRET_ACCESS_KEY \
  -e AWS_DEFAULT_REGION \
  "${IMAGE}" \
  --endpoint-url "${ENDPOINT}" "$@"
