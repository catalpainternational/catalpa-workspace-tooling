{
	# Bind admin to all interfaces INSIDE the container; the docker run mapping
	# publishes it only to the host loopback (-p 127.0.0.1:2019:2019), so it is
	# not reachable from the LAN. Binding to 127.0.0.1 here would make the
	# published port unreachable (container loopback only).
	admin 0.0.0.0:2019
	local_certs

	# Stable, recognizable names for the local dev CA so it is easy to find,
	# audit, and remove in the OS trust store (Keychain / ca-certificates).
	# The root key+cert are persisted on the host (see docker run -v mapping of
	# /data), so this CA is minted once per machine and trusted once.
	# The {$VAR:default} form is substituted as literal text when the Caddyfile
	# is adapted, so each machine's CA is identifiable in the trust store. The
	# machine label is passed via -e CATALPA_LOCAL_DEV_MACHINE on `docker run`.
	pki {
		ca local {
			name "Catalpa Local Dev CA ({$CATALPA_LOCAL_DEV_MACHINE:local})"
			root_cn "Catalpa Local Dev Root ({$CATALPA_LOCAL_DEV_MACHINE:local})"
			intermediate_cn "Catalpa Local Dev Intermediate ({$CATALPA_LOCAL_DEV_MACHINE:local})"
		}
	}

	# A fallback site (below) may ask for a certificate when a name is first visited. Only
	# local names get one, so the proxy never mints certificates for whatever a client sends.
	on_demand_tls {
		ask http://localhost:5555/local-name
	}
}

# Answers on_demand_tls above, for the names of a fallback site that asks for certificates on
# demand: 200 only for local names. Stack and LAN routes get certificates by name and are never
# checked here.
http://localhost:5555 {
	@local_name expression <<CEL
		{query.domain}.endsWith(".localhost")
		|| {query.domain}.endsWith(".localdev.temp.build")
		CEL
	respond @local_name 200
	respond 403
}

:443 {
}

:80 {
	handle_path /catalpa-local-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# Fallback sites another tool on this machine adds, for names no stack here routes (a
# workstation's Podman copies behind containerwharf's edge, say). dk puts each stack's route
# ahead of them, so a fallback never takes a stack's name; a fallback names its hosts rather
# than catching all, for stacks whose older dk adds routes after it. The folder is
# ~/.config/catalpa/local-proxy/sites on the host; after changing it, run `dk proxy reload`.
import /data/sites/*.caddy
