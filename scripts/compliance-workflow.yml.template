# Optional CI gate for OSS compliance. Copy to consumer .github/workflows/compliance.yml
#
# Replace every <FRONTEND_DIR> below with this project's frontend directory — the same
# value as `compliance.javascript.cwd` (falling back to `paths.frontend`) in tooling.yaml.
# Match the pnpm/node versions to `native.frontend.package_manager` / `node_version` too.
name: Compliance

on:
  pull_request:
  push:
    branches:
      - main
      # Add your long-running release branches, e.g. dev-7.4, dev-8.0

permissions:
  contents: read

jobs:
  compliance:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive
          # When platform code lives in a private submodule, use a PAT secret in this repo:
          # token: ${{ secrets.SUBMODULE_CHECKOUT_PAT }}

      - uses: astral-sh/setup-uv@v5

      - name: Install workspace tooling and compliance deps
        run: uv sync --group compliance

      - uses: pnpm/action-setup@v4
        with:
          version: 10

      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: pnpm
          cache-dependency-path: <FRONTEND_DIR>/pnpm-lock.yaml

      - name: Install frontend dependencies
        working-directory: <FRONTEND_DIR>
        run: pnpm install --frozen-lockfile

      - name: Compliance gate
        run: uv run tests compliance --check-only --ci

# Tag-release image publishes (consumer push-images.yml) should also run this gate
# before `uv run dk push`, so web/proxy can merge compliance/sbom/bom.cdx.json.
