# Optional CI gate for OSS compliance. Copy to consumer .github/workflows/compliance.yml
name: Compliance

on:
  pull_request:
  push:
    branches:
      - main
      # Add your long-running release branches, e.g. dev-7.4, dev-8.0

permissions:
  contents: read

jobs:
  compliance:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive
          # When platform code lives in a private submodule, use a PAT secret in this repo:
          # token: ${{ secrets.SUBMODULE_CHECKOUT_PAT }}

      - uses: astral-sh/setup-uv@v5

      - name: Install workspace tooling and compliance deps
        run: uv sync --group compliance

      # Match paths.frontend / compliance.javascript.cwd (Bero consumers: bero).
      - uses: pnpm/action-setup@v4
        with:
          version: 10

      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: pnpm
          cache-dependency-path: bero/pnpm-lock.yaml

      - name: Install frontend dependencies
        working-directory: bero
        run: pnpm install --frozen-lockfile

      - name: Compliance gate
        run: uv run test compliance --check-only --ci
