{
  "permissions": {
    "allow": [
      "Bash(git merge-tree *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git ls-tree *)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree.py\" create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree.py\" remove"
          }
        ]
      }
    ]
  }
}
